pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Verify Build Environment') {
            steps {
                sh '''
                    echo "===== JAVA ====="
                    java -version

                    echo "===== MAVEN ====="
                    mvn -version
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh 'mvn -B clean verify'
            }
        }

        stage('Verify WAR Artifact') {
            steps {
                sh '''
                    echo "===== GENERATED WAR FILES ====="
                    ls -lh target/*.war
                '''
            }
        }
    }

    post {
        success {
            archiveArtifacts(
                artifacts: 'target/*.war',
                fingerprint: true
            )
            echo 'CI pipeline completed successfully.'
        }

        failure {
            echo 'CI pipeline failed. Check the stage console output.'
        }
    }
}
